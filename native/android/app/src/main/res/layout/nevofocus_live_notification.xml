<?xml version="1.0" encoding="utf-8"?>
<!-- A full-width pure-black content capsule inside Android's mandatory notification shell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:background="@drawable/nevofocus_black_capsule">

    <Chronometer
        android:id="@+id/focus_chronometer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:contentDescription="Canlı kronometre" />

    <TextView
        android:id="@+id/focus_pause"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/nevofocus_control_button"
        android:text="Ⅱ"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:contentDescription="Durdur veya devam et" />

    <TextView
        android:id="@+id/focus_break"
        android:layout_width="58dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/nevofocus_control_button"
        android:text="MOLA"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        android:textSize="11sp"
        android:contentDescription="Molayı başlat veya bitir" />
</LinearLayout>
