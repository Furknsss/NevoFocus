<?xml version="1.0" encoding="utf-8"?>
<!-- One single premium black strip. Android 12+ owns the outer notification frame. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="5dp"
    android:background="@drawable/nevofocus_black_capsule">

    <TextView
        android:id="@+id/focus_main_time"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:text="00:00"
        android:textColor="#FFFFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:contentDescription="Çalışma süresi saat ve dakika" />

    <TextView
        android:id="@+id/focus_seconds"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="8dp"
        android:text=":00"
        android:textColor="#FFE5E5E7"
        android:textSize="16sp"
        android:textStyle="normal"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:contentDescription="Saniye" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/focus_pause"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="5dp"
        android:src="@drawable/nevofocus_action_pause"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Durdur veya devam et" />

    <ImageView
        android:id="@+id/focus_break"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/nevofocus_action_break"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Mola veya molayı bitir" />
</LinearLayout>
