<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded custom content. Android 12+ still decorates the outer notification. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="12dp"
    android:background="@drawable/nevofocus_black_capsule">

    <Chronometer
        android:id="@+id/focus_chronometer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical|start"
        android:textColor="#FFFFFFFF"
        android:textSize="29sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:contentDescription="Canlı kronometre" />

    <TextView
        android:id="@+id/focus_pause"
        android:layout_width="50dp"
        android:layout_height="42dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/nevofocus_control_button"
        android:text="Ⅱ"
        android:textColor="#FFFFFFFF"
        android:textSize="19sp"
        android:contentDescription="Durdur veya devam et" />

    <TextView
        android:id="@+id/focus_break"
        android:layout_width="66dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/nevofocus_control_button"
        android:text="MOLA"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:letterSpacing="0.04"
        android:contentDescription="Molayı başlat veya bitir" />
</LinearLayout>
