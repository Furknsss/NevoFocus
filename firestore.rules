rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheersReceived']));
      allow delete: if isOwner(userId);

      // Focus sessions subcollection
      match /sessions/{sessionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Live Cheer Notifications subcollection
      match /cheers/{cheerId} {
        allow list, get: if isOwner(userId);
        allow create: if isSignedIn() && isValidId(cheerId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Collaborative Study Rooms & Room Chat
    match /study_rooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      // Room chat messages subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId);
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
