rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Owner-only profile, private focus history and tasks.
    // The users document contains detailed study snapshots and must NOT
    // be publicly readable.
    match /users/{uid} {
      allow read, create, update, delete: if isOwner(uid);

      match /sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }
      match /tasks/{taskId} {
        allow read, write: if isOwner(uid);
      }
      match /active_focus/{docId} {
        allow read, write: if isOwner(uid);
      }
      match /backups/{backupId} {
        allow read, write: if isOwner(uid);
      }
      match /cheers/{cheerId} {
        allow read, delete: if isOwner(uid);
        allow create: if signedIn()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.toUserId == uid;
        allow update: if isOwner(uid);
      }
    }

    // Old shared cross-user backup documents were public. Never re-enable.
    match /test/{docId} {
      allow read, write: if false;
    }

    // The community data model requires a separate access-control review.
    // Protect it during migration rather than granting cross-user write.
    match /study_rooms/{roomId} {
      allow read: if signedIn();
      allow write: if false;
      match /messages/{messageId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
