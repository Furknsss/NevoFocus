rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profile documents - public read allows students list & community showcase without auth error
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Private user sessions
      match /sessions/{sessionId} {
        allow read, write: if true;
      }

      // Private user tasks
      match /tasks/{taskId} {
        allow read, write: if true;
      }

      // Live Cheer notifications
      match /cheers/{cheerId} {
        allow read, write: if true;
      }
    }

    // Collaborative Study Rooms & Messages - public read, open write so all students can create, join, chat
    match /study_rooms/{roomId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
  }
}

